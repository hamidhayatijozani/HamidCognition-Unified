{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hamidhayatijozani/HamidCognition-Unified/blob/main/schemas/strategic-intelligence.record.schema.json",
  "title": "Strategic Intelligence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "claim",
    "source",
    "observed_at",
    "confidence"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "SELF_CAPABILITY",
        "CREATOR_FACT",
        "MARKET_FACT",
        "COUNTER_EVIDENCE",
        "OPPORTUNITY"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "segment": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implication": {
      "type": "string"
    }
  }
}