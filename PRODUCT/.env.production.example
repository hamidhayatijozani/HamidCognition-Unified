# HamidCognition Action Gate production Compose template.
# Copy to action_gate/.env.production on the deployment host. Never commit real secrets.
# Generate each secret independently in the customer's secret manager.

ACTION_GATE_ENV=production
ACTION_GATE_API_TOKEN=REPLACE_IN_SECRET_MANAGER
ACTION_GATE_SIGNING_SECRET=REPLACE_IN_SECRET_MANAGER
ACTION_GATE_AUTHORITY_SECRET=REPLACE_IN_SECRET_MANAGER
ACTION_GATE_STATE_ORACLE_SECRET=REPLACE_IN_SECRET_MANAGER
ACTION_GATE_APPROVAL_SECRET=REPLACE_IN_SECRET_MANAGER
ACTION_GATE_KEY_ID=hhj-action-gate-1
ACTION_GATE_SIGNING_KEYS=
ACTION_GATE_RATE_LIMIT_PER_MINUTE=120
ACTION_GATE_DECISION_TTL_SECONDS=300
ACTION_GATE_APPROVAL_TTL_SECONDS=300

POSTGRES_DB=action_gate
POSTGRES_USER=action_gate
POSTGRES_PASSWORD=REPLACE_IN_SECRET_MANAGER

MCP_BEARER_TOKEN=REPLACE_IN_SECRET_MANAGER
MCP_ISSUER_URL=REPLACE_WITH_CUSTOMER_ISSUER_URL
MCP_RESOURCE_URL=https://gate.example.com/mcp
MCP_REQUIRED_SCOPE=mcp:execute
MCP_CLIENT_ID=chatgpt-demo-client
MCP_TOKEN_TTL_SECONDS=3600

DOMAIN=gate.example.com

# Optional policy JSON. Leave empty only if the reviewed release policy is intended.
ACTION_GATE_POLICY_JSON=
