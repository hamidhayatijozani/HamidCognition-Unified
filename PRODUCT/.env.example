# Action Gate 0.4.2 non-production example
# DO NOT PUT REAL SECRETS IN THIS FILE.

ACTION_GATE_ENV=development
ACTION_GATE_HOST=0.0.0.0
ACTION_GATE_PORT=8000
ACTION_GATE_SIGNING_SECRET=REPLACE_IN_SECRET_MANAGER
ACTION_GATE_DATABASE_URL=postgresql://action_gate:REPLACE_PASSWORD@postgres:5432/action_gate
ACTION_GATE_PRODUCTION_EXECUTION=false
ACTION_GATE_LOG_LEVEL=INFO
ACTION_GATE_EVIDENCE_PATH=/var/lib/action-gate/evidence
