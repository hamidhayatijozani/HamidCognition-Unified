{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIMORGH Manifest Schema",
  "type": "object",
  "required": ["project","node_identity","timestamp_utc","session_id","artifact_type","content_summary","content_hash_sha256","redaction_level","manifest_sha256"],
  "properties": {
    "project": {"type":"string"},
    "node_identity": {"type":"string"},
    "timestamp_utc": {"type":"string","format":"date-time"},
    "session_id": {"type":"string"},
    "artifact_type": {"type":"string"},
    "content_summary": {"type":"string"},
    "content_hash_sha256": {"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "content_uri": {"type":["string","null"]},
    "provenance": {
      "type":"object",
      "properties":{
        "created_by":{"type":"string"},
        "tools":{"type":"array","items":{"type":"string"}},
        "dataset_refs":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": false
    },
    "redaction_level": {"type":"string","enum":["none","partial","full"]},
    "manifest_sha256": {"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "verification_notes": {"type":["string","null"]}
  },
  "additionalProperties": false
}