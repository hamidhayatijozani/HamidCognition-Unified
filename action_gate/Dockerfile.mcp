ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}
WORKDIR /app

COPY action_gate/requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt

COPY action_gate/action_gate_sdk.py action_gate/chatgpt_mcp_server.py action_gate/test_mcp_auth.py action_gate/test_mcp_e2e.py ./

USER 10001
EXPOSE 8787

CMD ["python", "chatgpt_mcp_server.py"]
