{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hamidcognition.dev/schemas/decision_object-0.1.json",
  "title": "HHJ-CSG Decision Object",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "decision_id", "request_id", "request_digest", "decision_digest", "decision", "risk_level", "policy_version", "algorithm_version", "canonicalization_version", "issued_at", "expires_at", "nonce", "signature", "signature_algorithm", "key_id", "metrics_snapshot", "execution_receipt"],
  "properties": {
    "contract_version": {"const": "DO-0.1"},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"type": "string", "enum": ["ALLOW", "DENY", "ASK", "SANDBOX", "DEFER"]},
    "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "algorithm_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "canonicalization_version": {"const": "JCS-LITE-0.1"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 128},
    "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature_algorithm": {"const": "HMAC-SHA256"},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "metrics_snapshot": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean", "null"]}},
    "execution_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision_id", "request_digest"],
      "properties": {
        "status": {"const": "PENDING_EXECUTION"},
        "decision_id": {"type": "string"},
        "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
